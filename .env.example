# AI Agent Quality Framework - Environment Variables
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env in the same directory
# 2. Replace the placeholder with your real Anthropic API key
# 3. NEVER commit your .env file to version control
#
# Get your API key at: https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional: Model selection (default: claude-haiku-4)
# Options: claude-haiku-4, claude-sonnet-4, claude-opus-4
MODEL=claude-haiku-4

# Optional: Human escalation confidence threshold (default: 0.75)
ESCALATION_THRESHOLD=0.75
